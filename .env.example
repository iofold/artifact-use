# Hosted API default used by the CLI and local MCP server.
ARTIFACT_USE_API_BASE=https://art-use.iofold.com

# For headless agents/CI. Obtain via WorkOS OAuth/AuthKit or a short-lived
# service-issued token. Do not commit real tokens.
ARTIFACT_USE_TOKEN=

# Worker vars/secrets. Copy selected values into Cloudflare Wrangler vars/secrets.
WORKOS_AUTHKIT_URL=https://your-subdomain.authkit.app
WORKOS_AUDIENCE=https://art-use.iofold.com
WORKOS_ISSUER=https://your-subdomain.authkit.app
WORKOS_JWKS_URL=https://your-subdomain.authkit.app/oauth2/jwks
SITE_BASE_URL=https://art-use.iofold.com
SESSION_SECRET=replace-with-32-plus-random-bytes
RESEND_API_KEY=
