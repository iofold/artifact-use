# Hosted API default used by the CLI and local MCP server.
ARTIFACT_USE_API_BASE=https://artifacts.example.com

# For headless agents/CI. Obtain via WorkOS OAuth/AuthKit or a short-lived
# service-issued token. Do not commit real tokens.
ARTIFACT_USE_TOKEN=

# Worker vars/secrets. Copy selected values into Cloudflare Wrangler vars/secrets.
WORKOS_AUTHKIT_URL=https://your-authkit-domain
WORKOS_AUDIENCE=https://artifacts.example.com/mcp
WORKOS_ISSUER=https://your-authkit-domain
WORKOS_JWKS_URL=https://your-authkit-domain/oauth2/jwks
WORKOS_CLIENT_ID=client_...
WORKOS_API_KEY=
ARTIFACT_USE_AUTH_SCOPES=openid profile email offline_access
ARTIFACT_USE_READ_SCOPES=openid
ARTIFACT_USE_WRITE_SCOPES=openid
SITE_BASE_URL=https://artifacts.example.com
ARTIFACT_PUBLIC_PATH_PREFIX=/go
ARTIFACT_USE_PRIVACY_URL=
ARTIFACT_USE_TERMS_URL=
ARTIFACT_USE_SUPER_ADMIN_USER_IDS=user_...
MAIL_FROM=artifacts@example.com
MAIL_FROM_NAME=Artifact Use
SESSION_SECRET=replace-with-32-plus-random-bytes
# Configure the native `EMAIL` binding and its allowed sender in wrangler.toml.

# Optional local-only bearer token escape hatch. If set, DEV_AUTH_USER_ID must
# be a real WorkOS user id; created_by is never allowed to use synthetic labels.
DEV_AUTH_TOKEN=
DEV_AUTH_USER_ID=user_...
DEV_AUTH_ORG_ID=
DEV_AUTH_EMAIL=

# Optional CI/vault key names that can be mapped into deployment config.
WORKOS_AUTHKIT_DOMAIN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
