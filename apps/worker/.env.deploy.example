# Environment-specific deploy values for YOUR Cloudflare account.
#
# Copy to `apps/worker/.env.deploy` (gitignored) and fill in. This is the single
# human-readable reference for the values used by the gitignored, operative
# deploy configs (`wrangler.prod.toml` / `wrangler.staging.toml`) — so the
# committed `wrangler.toml` can stay sanitized with placeholders for the public
# repo.
#
# Secrets do NOT belong here. Set them with `wrangler secret put` (SESSION_SECRET,
# WORKOS_CLIENT_ID, WORKOS_API_KEY, RESEND_API_KEY, DEV_AUTH_TOKEN). Local-dev
# secrets live in `apps/worker/.dev.vars` (also gitignored).

CLOUDFLARE_ACCOUNT_ID=
WORKERS_DEV_SUBDOMAIN=              # e.g. acme  ->  *.acme.workers.dev

# Production
PROD_HOST=artifacts.example.com
PROD_ZONE=example.com
PROD_D1_DATABASE_ID=
PROD_R2_BUCKET=artifact-use
PROD_WORKOS_AUTHKIT_URL=https://your-authkit-domain.example
PROD_ABUSE_EMAIL=abuse@example.com
SUPER_ADMIN_USER_IDS=              # comma-separated WorkOS user_... ids

# Staging (optional; isolated resources so prod is never touched)
STAGING_D1_DATABASE_ID=
STAGING_R2_BUCKET=artifact-use-staging
STAGING_ABUSE_EMAIL=abuse-staging@example.com
