{
  "name": "@artifact-use/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "widget:build": "node scripts/build-feedback-widget.mjs",
    "llms:build": "node scripts/build-llms.mjs",
    "build": "npm run widget:build && npm run llms:build && tsc --noEmit",
    "dev": "wrangler dev",
    "deploy": "node scripts/check-legal-assets.mjs wrangler.toml && wrangler deploy",
    "typecheck": "npm run widget:build && npm run llms:build && tsc --noEmit",
    "migrate:local": "wrangler d1 migrations apply artifact-use --local",
    "migrate:remote": "wrangler d1 migrations apply artifact-use --remote",
    "check:legal": "node scripts/check-legal-assets.mjs",
    "deploy:prod": "node scripts/check-legal-assets.mjs wrangler.prod.toml && wrangler deploy --config wrangler.prod.toml"
  },
  "dependencies": {
    "artifact-use-core": "*",
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260601.0",
    "esbuild": "^0.28.0",
    "wrangler": "^4.19.1"
  }
}
