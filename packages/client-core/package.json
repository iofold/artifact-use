{
  "name": "artifact-use-core",
  "version": "0.2.0",
  "description": "Shared publish client, folder walker, and MCP tool schemas used by the Artifact Use CLI and stdio MCP server.",
  "license": "MIT",
  "homepage": "https://artifacts.iofold.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iofold/artifact-use.git",
    "directory": "packages/client-core"
  },
  "bugs": {
    "url": "https://github.com/iofold/artifact-use/issues"
  },
  "keywords": [
    "artifact-use",
    "artifacts",
    "publishing",
    "mcp"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "default": "./dist/schemas.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepack": "tsc"
  }
}
