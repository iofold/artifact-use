{
  "name": "@artifact-use/mcp-server",
  "version": "0.2.0",
  "description": "Local stdio MCP server for Artifact Use: publish local folders and HTML as stable, gated, reviewable links with a creator token, and manage comments, access, and share links.",
  "license": "MIT",
  "homepage": "https://artifacts.iofold.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iofold/artifact-use.git",
    "directory": "packages/mcp-server"
  },
  "bugs": {
    "url": "https://github.com/iofold/artifact-use/issues"
  },
  "keywords": [
    "artifact-use",
    "artifacts",
    "publishing",
    "mcp",
    "agents"
  ],
  "type": "module",
  "bin": {
    "artifact-use-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "prepack": "tsc"
  },
  "dependencies": {
    "@artifact-use/client-core": "^0.2.0",
    "@modelcontextprotocol/sdk": "^1.12.1"
  },
  "devDependencies": {
    "tsx": "^4.19.4"
  }
}
